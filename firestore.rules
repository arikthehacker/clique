rules_version = '2';

// group stuff is for members, personal stuff is for its owner
service cloud.firestore {
  match /databases/{database}/documents {

    function signedIn() {
      return request.auth != null;
    }

    function isOwner(uid) {
      return signedIn() && request.auth.uid == uid;
    }

    function isMember(groupId) {
      return signedIn()
        && request.auth.uid in get(/databases/$(database)/documents/groups/$(groupId)).data.members;
    }

    // profiles are readable so invites can find a username
    match /users/{uid} {
      allow read: if signedIn();
      allow create, update: if isOwner(uid);
      allow delete: if false;

      match /events/{eventId} {
        allow read, write: if isOwner(uid);
      }

      match /memories/{memoryId} {
        allow read, write: if isOwner(uid);
      }

      match /reports/{reportId} {
        allow read, create: if isOwner(uid);
        allow update, delete: if false;
      }
    }

    // only members can see or change a group
    match /groups/{groupId} {
      allow read: if isMember(groupId);
      allow create: if signedIn()
        && request.resource.data.createdBy == request.auth.uid
        && request.auth.uid in request.resource.data.members;
      allow update: if isMember(groupId);
      allow delete: if false;

      match /messages/{messageId} {
        allow read: if isMember(groupId);
        allow create: if isMember(groupId)
          && request.resource.data.senderId == request.auth.uid;
        allow update, delete: if false;
      }

      // planning tools, any member can edit
      match /polls/{pollId} {
        allow read, write: if isMember(groupId);
      }

      match /todos/{todoId} {
        allow read, write: if isMember(groupId);
      }

      match /questions/{questionId} {
        allow read, write: if isMember(groupId);
      }

      match /expenses/{expenseId} {
        allow read, write: if isMember(groupId);
      }

      // availability, you only write your own
      match /availability/{uid} {
        allow read: if isMember(groupId);
        allow write: if isMember(groupId) && request.auth.uid == uid;
      }
    }
  }
}
